# Where the Bioptime API lives, for this build. Inlined into the JavaScript bundle at build time (EXPO_PUBLIC_*), so never a secret.
# Leave unset for the defaults: Android emulator -> http://10.0.2.2:3000, iOS simulator -> http://localhost:3000.
# A physical phone on the same Wi-Fi needs the Mac's LAN address, e.g. http://192.168.1.20:3000, or set it in the app under Me > Server.
# Production builds point at the deployed API over HTTPS.
EXPO_PUBLIC_API_BASE=

# 1 lets testers change the server address inside the app (Me > Server). Set only for demo/test builds; never for a store build.
EXPO_PUBLIC_ALLOW_SERVER_OVERRIDE=
