{
  "name": "@bioptime/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Bioptime shared backend: identity, packages, orders, entitlements, assignments, appointments, plans, bloodwork, messaging, notifications, audit.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/cli.ts migrate",
    "seed": "tsx src/cli.ts seed",
    "reset-demo": "tsx src/cli.ts reset-demo",
    "create-admin": "tsx src/cli.ts create-admin",
    "create-owner": "tsx src/cli.ts create-owner",
    "openapi": "tsx src/cli.ts openapi",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "test:unit": "node --import tsx --test \"tests/unit/*.test.ts\"",
    "test:integration": "node --import tsx --test \"tests/integration/*.test.ts\""
  },
  "dependencies": {
    "@bioptime/domain": "*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.2.0",
    "fastify": "^5.3.3",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
