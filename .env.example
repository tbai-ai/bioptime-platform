# Bioptime platform · environment template. Copy to .env (never commit .env). Every value here is a placeholder.

# demo | development | production. demo seeds synthetic data, uses the payment simulator, the LabStack stand-in and the
# notification outbox, and labels every surface. production refuses to start without real providers.
BIOPTIME_MODE=demo
PORT=3000
HOST=127.0.0.1
# Public origin of this server (cookies, links in emails, webhook addresses). No trailing slash.
PUBLIC_ORIGIN=http://localhost:3000
# Extra origins allowed by CORS (the Vite dashboard dev server, the Expo dev client), comma separated.
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,exp://127.0.0.1:8081

# SQLite file (PostgreSQL is the production target; see docs/PRODUCTION_READINESS.md)
DATABASE_PATH=./data/bioptime.sqlite
REPORTS_DIR=./data/reports
# Website images that administrators upload (served publicly by id)
ASSETS_DIR=./data/assets
# Private files (progress photos, meal photos, message attachments, data exports): outside every static folder,
# opened only through 5-minute tokens. local is the only storage provider so far; production refuses it as soon as a
# module that stores private files is enabled (object storage with encryption at rest is pending configuration).
PRIVATE_FILES_DIR=./data/private
STORAGE_PROVIDER=local

# Secrets: generate with `openssl rand -hex 32`. Required outside demo mode.
SESSION_SECRET=change-me-session-secret
TOKEN_SECRET=change-me-token-secret

# Static surfaces served by the API in integrated local mode (absolute or relative to apps/api)
WEBSITE_DIR=../../../../drive
DASHBOARD_DIR=../dashboard/dist

# Payments: simulator (demo/dev) or a real provider adapter once chosen (decision open).
PAYMENT_PROVIDER=simulator
PAYMENT_WEBHOOK_SECRET=change-me-payment-webhook-secret

# Bloodwork vendor (LabStack Labs API v1.3): standin (demo/dev) or live.
LABSTACK_MODE=standin
LABSTACK_BASE_URL=https://integration.labstack.in/api/v1.3
LABSTACK_API_KEY=
LABSTACK_API_KEY_NEXT=
LABSTACK_WEBHOOK_HEADER=key
LABSTACK_WEBHOOK_VALUE=change-me-webhook-value
LABSTACK_STANDIN_SPEED=fast
LABSTACK_SAFETY_NET_MINUTES=30
LABSTACK_CATALOGUE_SYNC_HOURS=6
# Optional. LabStack partner key for its widget: generated by the LabStack account owner in the LabStack console under
# Widget configs > Access, and shown there once. Server environment only, never sent to a browser (the admin LabStack
# page shows only whether it is set). No widget token is minted yet: LabStack's token API documentation is not in the
# project. Leave empty until then.
LABSTACK_PARTNER_KEY=

# Notifications: outbox (records, never claims delivery) or a provider adapter when configured.
EMAIL_PROVIDER=outbox
SMS_PROVIDER=outbox
PUSH_PROVIDER=outbox
EMAIL_FROM=Bioptime <no-reply@bioptime.com>

# Providers not chosen yet: each accepts only none until an adapter exists (Admin › Integrations names what is missing).
# Meetings (video calls for consultations and sessions), calendar sync, course video hosting, Coach AI drafting.
MEETING_PROVIDER=none
CALENDAR_PROVIDER=none
VIDEO_PROVIDER=none
AI_PROVIDER=none

# Exercise demonstration clips and posters, served by this server (not by VIDEO_PROVIDER): server, or none for text-only
# exercises. The folder holds manifest.json and the hashed files written by `npx tsx src/cli.ts media:import-exercises`.
EXERCISE_MEDIA=server
EXERCISE_MEDIA_DIR=./media/exercises

# Assignment policy: auto (rule assigns when one eligible coach is clear) or manual (admin confirms every one)
ASSIGNMENT_POLICY=manual
# What one bloodwork entitlement means: panel | collection | test (configurable, see docs)
ENTITLEMENT_UNIT=collection

# Sessions
SESSION_DAYS=30
ADMIN_SESSION_HOURS=12

# Sign in with Google and Apple for members (apps/api/src/auth/social.ts). Public identifiers, never secrets: the API
# returns them in GET /public/config and verifies ID tokens against the providers' published keys. Google is offered
# once any client ID is set (the owner's Google Cloud OAuth clients: iOS, Android, web); Apple once a bundle ID (the
# app's is com.bioptime.app, with Sign in with Apple enabled on it in the Apple Developer Program) or the Services ID
# is set and Apple's keys can be fetched. With all five empty neither button is offered. Demo mode also offers the stand-in.
GOOGLE_SIGN_IN_WEB_CLIENT_ID=
GOOGLE_SIGN_IN_IOS_CLIENT_ID=
GOOGLE_SIGN_IN_ANDROID_CLIENT_ID=
APPLE_SIGN_IN_BUNDLE_IDS=
APPLE_SIGN_IN_SERVICES_ID=

# Background jobs inside the server process (reminders, outbox, LabStack safety net, module jobs): true | false
JOBS_ENABLED=true
# Per-IP rate limits on the API: on | off (off only for local tests)
RATE_LIMITS=on

# Which proxies may set X-Forwarded-For: empty = none (direct connections), true = any proxy in front (only when you control it),
# or a comma-separated list of proxy addresses / CIDRs. Wrong values make per-IP rate limits and audit addresses attacker-chosen.
TRUST_PROXY=

# Open preview (demo only; owner decision, 30 October 2026): 1 opens every workspace without signing in
# (POST /api/auth/open-preview; apps/api/src/auth/openPreview.ts). Effective only with BIOPTIME_MODE=demo: any other mode
# refuses to start with it. Leave it empty here; the shared link's server copy sets it on its own command line. Unset it
# and restart to turn signing in back on.
OPEN_PREVIEW=
